{
  "name": "quevamos-servidor",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de Quevamos: API, motor de disponibilidad y base de datos",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/principal.ts",
    "build": "esbuild src/principal.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/principal.js",
    "start": "node dist/principal.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
