# Configuración de desarrollo del servidor de Quevamos.
# Si no existe .env, el servidor usa este archivo tal cual: no hace falta copiarlo para empezar.
# En producción estas variables se definen en el proveedor, y el servidor no arranca con las claves de aquí.

NODE_ENV=development
PUERTO=3000
HOST=127.0.0.1

# Sin DATABASE_URL, el servidor usa PGlite (PostgreSQL dentro del propio proceso) y guarda los datos
# en DIRECTORIO_DATOS. Borra esa carpeta para empezar de cero.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/quevamos?sslmode=require
DIRECTORIO_DATOS=.datos

# Claves de 32 bytes en base64. Estas solo valen para desarrollo. Para generar otras:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_HMAC=06N7toQCWDr90PEm7etOKvDtmNG1GnsNzC1S4BBh+pk=
CLAVE_CIFRADO=oKMKoiIxtNuJf/H2CCa8TH2XGnw940ulSQU2gzqvrGI=

# Orígenes que pueden llamar a la API desde un navegador (la versión web de la app en desarrollo).
ORIGENES_PERMITIDOS=http://localhost:8081

# Ponlo a true solo detrás del proxy del proveedor, para que los límites usen la IP real.
CONFIAR_EN_PROXY=false
